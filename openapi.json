{
  "openapi": "3.0.0",
  "info": {
    "title": "REST API - Engine Scrapyard",
    "version": "1.0.0",
    "description": "API REST con autenticación JWT, Refresh Token y rate limit."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Auth": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string", "example": "Alex" },
          "password": { "type": "string", "example": "123456" }
        },
        "required": ["nombre", "password"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 0 },
          "nombre": { "type": "string", "example": "Ana" },
          "edad": { "type": "integer", "example": 22 },
          "password": { "type": "string", "example": "123456" }
        },
        "required": ["nombre", "password"]
      },
      "Engine": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 0 },
          "marca": { "type": "string", "example": "Renault" },
          "modelo": { "type": "string", "example": "K9K 1.5 dCi" },
          "cilindrada": { "type": "integer", "example": 1461 },
          "combustible": { "type": "string", "example": "Diesel" },
          "kilometros": { "type": "integer", "example": 120000 },
          "precio": { "type": "number", "example": 850 }
        },
        "required": ["marca", "modelo", "cilindrada", "combustible", "kilometros", "precio"]
      }
    },
    "parameters": {
      "id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
    }
  },
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Iniciar sesión",
        "tags": ["Authentication"],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Auth" } } }
        },
        "responses": { "200": { "description": "Tokens de acceso y refresco" } }
      }
    },
    "/api/refresh": {
      "post": {
        "summary": "Renovar access token",
        "tags": ["Authentication"],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Nuevo accessToken" } }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Listar usuarios",
        "tags": ["Users"],
        "responses": { "200": { "description": "Lista de usuarios" } }
      },
      "post": {
        "summary": "Crear usuario",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
        },
        "responses": { "200": { "description": "Usuario creado" } }
      }
    },
    "/api/users/{id}": {
      "get": {
        "summary": "Obtener usuario por ID",
        "tags": ["Users"],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": { "200": { "description": "Usuario encontrado" } }
      },
      "put": {
        "summary": "Actualizar usuario",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": { "nombre": { "type": "string" }, "edad": { "type": "integer" } } } } }
        },
        "responses": { "200": { "description": "Usuario actualizado" } }
      },
      "delete": {
        "summary": "Eliminar usuario",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": { "200": { "description": "Usuario eliminado" } }
      }
    },
    "/api/motores": {
      "get": {
        "summary": "Listar motores",
        "tags": ["Engines"],
        "responses": { "200": { "description": "Lista de motores" } }
      },
      "post": {
        "summary": "Añadir motor",
        "tags": ["Engines"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Engine" } } }
        },
        "responses": { "200": { "description": "Motor añadido" } }
      }
    },
    "/api/motores/{id}": {
      "get": {
        "summary": "Obtener motor por ID",
        "tags": ["Engines"],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": { "200": { "description": "Motor encontrado" } }
      },
      "put": {
        "summary": "Actualizar motor",
        "tags": ["Engines"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Engine" } } }
        },
        "responses": { "200": { "description": "Motor actualizado" } }
      },
      "delete": {
        "summary": "Eliminar motor",
        "tags": ["Engines"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": { "200": { "description": "Motor eliminado" } }
      }
    }
  }
}